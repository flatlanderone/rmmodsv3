<RamblingMan>

<conditional>
<if cond="mod_loaded('Telrics_Horses_V3') and mod_loaded('0-SCore_sphereii')">
<!-- 
	fuelKmPerL	10 	5 gas per 2 km 
					2,5 gas per 1 km
					25 gas per 10 km

	fuelKmPerL	5 	10 gas per 2 km 
					5 gas per 1 km
					50 gas per 10 km
					100 gas per 20 km
					500 gas per 100 km

	fuelKmPerL	1 	50 gas per 2 km 
					25 gas per 1 km
					250 gas per 10 km
					
	fuelKmPerL	0,1 500 gas per 2 km 
					250 gas per 1 km
					2500 gas per 10 km
					
-->

<!-- Add fuelKmPerL value for the new fuel types. -->
<set xpath="//vehicle[contains(@name,'Horse')]/property[@class='engine']/property[@name='fuelKmPerL']/@value">5</set>


<!-- Add new fuel type. Set tank capacity.

A tank capacity of 4 fits 100 units of fuel, eg 100 units of Horse mix.

TODO: add additional fuel types.

-->
<set xpath="//vehicle[contains(@name,'Horse')]/property[@class='fuelTank']">
			<property name="class" value="FuelTank"/>
			<property name="fuelType" value="HorseMixFTLR" />
			<property name="capacity" value="4"/>
</set>

</if>
</conditional>



